# ═══════════════════════════════════════════════════════
# BACKEND  (Python / FastAPI)
# ═══════════════════════════════════════════════════════

# Virtual environment
backend/venv/
backend/.venv/
backend/env/

# Python cache
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/.Python

# Env files (keep .env.example, ignore real secrets)
backend/.env
