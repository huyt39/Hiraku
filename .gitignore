# Pytest / coverage
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
backend/coverage.xml

# Build / dist
backend/dist/
backend/build/
backend/*.egg-info/

# ═══════════════════════════════════════════════════════
# FRONTEND  (Next.js / Node)
# ═══════════════════════════════════════════════════════

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Build output
frontend/.next/
frontend/out/
frontend/dist/

# Env files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
# frontend/.env.example  ← committed intentionally

# Debug logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# TypeScript build info
