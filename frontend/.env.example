# SkillBridge Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
#
# Required for production (Vercel deployment):
#   Set NEXT_PUBLIC_API_URL to your deployed backend URL, e.g.:
#   https://skillbridge-api.vercel.app
#
# Leave blank for local development (defaults to http://localhost:8000)
NEXT_PUBLIC_API_URL=
